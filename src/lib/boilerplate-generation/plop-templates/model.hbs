import { Schema, model } from 'mongoose';
import type { {{firstType types}} } from '../types';

const {{properCase name}}Schema = new Schema<{{firstType types}}>({
  // Define your schema fields
  title: { type: String, required: true },
  description: { type: String },
  status: { 
    type: String, 
    enum: ['active', 'inactive', 'archived'],
    default: 'active'
  },
  createdAt: { type: Date, default: Date.now },
  updatedAt: { type: Date, default: Date.now }
}, { 
  timestamps: true,
  toJSON: {
    virtuals: true,
    transform: (doc, ret) => {
      ret.id = ret._id;
      delete ret._id;
      delete ret.__v;
      return ret;
    }
  }
});

// Add indexes
{{properCase name}}Schema.index({ title: 'text' });

// Add virtuals or methods if needed
{{properCase name}}Schema.virtual('shortDescription').get(function() {
  return this.description?.substring(0, 100);
});

export const {{properCase name}} = model<{{firstType types}}>(
  '{{properCase name}}',
  {{properCase name}}Schema
);